# Copy this file to `.env.local` for local development, or set these variables
# in your hosting provider.

# Password for the admin area at /admin. Required: the admin area stays locked
# until this is set. Use a long, unique passphrase.
ADMIN_PASSWORD=

# Secret used to sign admin sessions. Use at least 32 random characters, e.g.
#   openssl rand -base64 48
# If unset, a key is derived from ADMIN_PASSWORD.
SESSION_SECRET=

# Where the timetable is stored.
#   Local file (default):   file:./data/uwais.db
#   Turso / libSQL server:  libsql://your-database.turso.io  (with DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/uwais.db
DATABASE_AUTH_TOKEN=

# Default timezone for a brand-new installation (IANA name). It can be changed
# later in Admin > Settings.
MOSQUE_TIMEZONE=Europe/London

# Public address of the site, used for links in metadata (no trailing slash).
SITE_URL=http://localhost:3000
